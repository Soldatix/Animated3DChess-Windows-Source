{
  "name": "chess-multiplayer-v11-prod",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "CHESS_ROOMS",
        "class_name": "ChessRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChessRoom"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://chess.appsandgames.org"
  },
  "observability": {
    "enabled": false
  }
}
